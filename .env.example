# QuestEdu 学问 · 配置模板
# 复制为 .env 后填写。.env 已被 .gitignore 排除，不会提交。
# 页面右上角齿轮里改的配置也会写进 .env，两者是同一份。
#
# 模式：
#   mock   完全离线，跑内置题库（默认，答辩断网保底）
#   cloud  云端 OpenAI 兼容接口（DeepSeek / Kimi / OpenAI / 任意网关）
#   local  本机 LM Studio / llama-server / Ollama（同样是 OpenAI 兼容接口）
#   hybrid 云端优先，连不上自动回落本地
INFERENCE_MODE=mock

# ---------- 云端 ----------
# 结尾不要带 /chat/completions；漏了 /v1 会自动补
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120

# 看图模型（拍照识别用）。留空则拿上面的主模型试一次；
# 主模型不支持图片时会明确报"当前模型不支持看图"。
LLM_VISION_MODEL=

# ---------- 本地（LM Studio / llama-server / Ollama）----------
# LM Studio 默认端口就是 1234，漏了 /v1 会自动补
LLM_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LLM_LOCAL_MODEL=qwen3.8
# 本地服务一般不需要 Key，但协议要求请求头里有东西，留空会用 sk-local
LLM_LOCAL_API_KEY=

# 本地看图模型（如 qwen2.5-vl-7b）。
# 留空 = 不能拍照：qwen3.8 这类文本模型不吃图片，硬发过去只会等很久然后报 400。
LLM_LOCAL_VISION_MODEL=

# 本地模型（尤其思考型 + 首次加载权重）慢一个量级，别用云端那套 60 秒
LLM_LOCAL_TIMEOUT=900

# ---------- 存储 ----------
# 默认 SQLite（data/questedu.db），重启不丢会话
# 换 PostgreSQL 只改这一行（SQLAlchemy 无缝迁移）
# DB_URL=postgresql+psycopg://user:pass@localhost:5432/questedu
# 想完全不留痕迹（比如跑测试）可设 STORE=memory
# STORE=memory
